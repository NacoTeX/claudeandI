{#
  Per-device ESPHome configuration for an ESPectre presence sensor.
  Rendered by app/builder.py from a validated DeviceCreate payload.

  Modelled on ESPectre's own example configurations rather than assembled
  from prose docs — see
  https://github.com/francescopace/espectre/tree/main/examples
#}
esphome:
  name: {{ device_name }}
  friendly_name: {{ friendly_name | tojson }}

esp32:
{% if board.esphome_board %}
  board: {{ board.esphome_board }}
{% endif %}
{% if board.variant %}
  variant: {{ board.variant }}
{% endif %}
{% if board.cpu_frequency %}
  cpu_frequency: {{ board.cpu_frequency }}
{% endif %}
  framework:
    type: esp-idf

wifi:
  ssid: {{ wifi_ssid | tojson }}
  password: {{ wifi_password | tojson }}
{% if wifi_bssid %}
  bssid: {{ wifi_bssid | tojson }}
{% endif %}
  # Reachable for reconfiguration if the credentials above stop working.
  ap:
    ssid: {{ (device_name ~ " Fallback") | tojson }}

captive_portal:

api:

ota:
  - platform: esphome

logger:
  level: INFO

# Lets Wi-Fi credentials be re-provisioned over USB without a rebuild.
improv_serial:

external_components:
  - source: github://francescopace/espectre@main
    components: [espectre]
{% if board.ble %}

# ESPectre's telemetry/control channel rides on this server; without it
# the component leaves BLE off and Echolot's "Live" view finds nothing.
# UUIDs and ids are the ones ESPectre's own examples and browser client
# expect — do not rename.
esp32_ble_server:
  id: espectre_ble_server
  services:
    - uuid: "d33ff46b-2203-4775-bc6f-b3a2c36af8f0"
      advertise: true
      characteristics:
        # Telemetry: 8 bytes, float32 movement + float32 threshold
        - id: espectre_ble_telemetry
          uuid: "119d5cac-48da-4bd9-bfc3-169805868258"
          notify: true
        # Sysinfo: text key=value lines terminated by END
        - id: espectre_ble_sysinfo
          uuid: "c8c89ffa-c401-461f-9ffc-942fa04adfe3"
          read: true
          notify: true
          value: ""
        # Control writes: REQ_SYSINFO, SET_THRESHOLD:X.XX
        - id: espectre_ble_control
          uuid: "33ed9214-a8d7-40e8-82d1-c82747dcdc71"
          write: true
          write_no_response: true
{% endif %}

espectre:
  detection_algorithm: {{ detection_algorithm }}
  traffic_generator_rate: {{ traffic_generator_rate }}
  traffic_generator_mode: {{ traffic_generator_mode }}
  segmentation_threshold: {{ segmentation_threshold }}
  movement_sensor:
    name: "Movement Score"
  motion_sensor:
    name: "Motion Detected"
  threshold_number:
    name: "Threshold"
  calibrate_switch:
    name: "Calibrate"
