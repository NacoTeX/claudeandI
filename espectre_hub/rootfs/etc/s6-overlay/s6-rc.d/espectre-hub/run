#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the ESPectre Hub backend
# ==============================================================================
bashio::log.info "Starting ESPectre Hub..."

LOG_LEVEL=$(bashio::config 'log_level' 'info')

cd /opt/espectre-hub || bashio::exit.nok "Could not find app directory"

exec python3 -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8099 \
    --log-level "${LOG_LEVEL}"
